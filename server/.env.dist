# Runtime
ENV=dev
LISTEN_ADDR=:4242
LOG_LEVEL=debug

# Abuse protection
# Comma-separated CIDRs of reverse proxies allowed to set X-Forwarded-For.
# Leave empty when clients connect directly to the server.
TRUSTED_PROXY_CIDRS=
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW=1h
MAX_FILES=500
MAX_FILE_BYTES=1048576
MAX_BODY_BYTES=16777216

# S3 storage
S3_BUCKET=awesome-prometheus-alerts-shares
S3_REGION=us-east-1
# https://s3.amazonaws.com for AWS S3, or the URL of MinIO, Cloudflare R2, Scaleway, OVH...
S3_ENDPOINT=http://minio:9000
S3_FORCE_PATH_STYLE=true
# Optional key prefix, e.g. "shares" stores uploads under shares/<date>/...
S3_PREFIX=

# S3 credentials (standard AWS variables). These match the local MinIO
# container from docker-compose.yml; never commit real credentials.
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
